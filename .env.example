# Copy to .env; edit locally. Never commit .env.
# URL-encode special characters in passwords, e.g. @ becomes %40.
# Plain TCP URLs only: explicit host/database, no URL query parameters.
DATABASE_URL=postgresql+psycopg://canteen_user:CHANGE_ME@127.0.0.1:5432/canteen_inventory
TEST_DATABASE_URL=postgresql+psycopg://canteen_user:CHANGE_ME@127.0.0.1:5432/canteen_inventory_test
CANTEEN_TIMEZONE=Asia/Kolkata

# Optional Docker database only. Set a local password before docker compose up.
# Docker listens on 5433; update both URLs above when choosing Docker.
POSTGRES_PASSWORD=
